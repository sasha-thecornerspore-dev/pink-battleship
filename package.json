{
  "name": "pink-battleship",
  "version": "0.1.0",
  "description": "Local-first desktop business cockpit for multi-platform content creators",
  "author": "Corner Spore",
  "license": "UNLICENSED",
  "private": true,
  "repository": "https://github.com/sasha-thecornerspore-dev/pink-battleship",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "rebuild": "electron-builder install-app-deps",
    "prototype": "electron-vite build && node scripts/prototype.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "electron-updater": "^6.8.9"
  },
  "optionalDependencies": {
    "sharp": "^0.34.4",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
